# Local settings for `npm run api`. Copy this file to .env (it is git-ignored) and change what you need.
# On Vercel these are set in Project → Settings → Environments → Production → Environment Variables instead.

# Sign-in. Leave unset for role picking (no password). "accounts" = personal accounts with passwords,
# with three demo accounts listed on the sign-in page.
LBC_AUTH_MODE=accounts

# Where local data is kept (default: /tmp/lbc-data.json, which is C:\tmp\lbc-data.json on Windows).
# LBC_DATA_PATH=./local-data.json

# Set to 0 to switch the demo accounts off (do this for real use).
# LBC_DEMO_ACCOUNTS=0

# Optional locally (a development secret is used if unset). Required on Vercel: a long random value.
# LBC_SESSION_SECRET=

# Optional: use a Supabase database instead of the local file (see supabase.sql).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
